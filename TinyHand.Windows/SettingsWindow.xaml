<Window x:Class="TinyHand.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TinyHand" Width="360" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24">
    <TextBlock Text="TinyHand" FontSize="26" FontWeight="SemiBold" />
    <TextBlock Text="A tiny hand pointer for your Windows screen."
               Margin="0,3,0,18" Foreground="#666" />
    <Button x:Name="ToggleButton" Content="Turn pointer on" Height="38"
            Click="Toggle_Click" />
    <TextBlock Text="Hand style" Margin="0,18,0,5" />
    <ComboBox x:Name="HandPicker" Height="30" SelectionChanged="HandPicker_SelectionChanged" />
    <TextBlock Text="Click and drag to draw. Clicks are captured while the pointer is on."
               TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#555" />
    <TextBlock Text="Ctrl+Alt+H: toggle    Ctrl+Alt+X: clear    Esc: turn off"
               FontSize="11" Margin="0,12,0,0" Foreground="#666" />
  </StackPanel>
</Window>
